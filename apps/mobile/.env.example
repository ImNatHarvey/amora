# Copy to .env and fill in from the Supabase dashboard (Project Settings > API).
# .env is gitignored and must never be committed.
# SUPABASE_URL looks like https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY is the publishable/anon key — never the secret/service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
